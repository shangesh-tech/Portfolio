# Copy to .env.local and fill in. .env.local is gitignored.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form submissions.
CONTACT_TO_EMAIL=you@example.com

# Sender shown on the email. "onboarding@resend.dev" works for testing;
# use an address on a domain verified in Resend for production.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
